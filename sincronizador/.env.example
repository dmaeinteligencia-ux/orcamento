# Copie para .env NESTA máquina (dentro da rede do DMAE). Nunca envie o .env para o GitHub.

# Banco interno (Compras e Contabilidade). Use um usuário SOMENTE LEITURA.
PG_HOST=
PG_PORTA=5432
PG_BANCO=
PG_USUARIO=
PG_SENHA=

# Supabase do Sistema de Orçamento (Project Settings → API).
SUPABASE_URL=https://qkqkigqwmuqxwklpfkqe.supabase.co
# Chave SECRETA (service_role / sb_secret_...). Fica só nesta máquina: ela grava os dados importados.
